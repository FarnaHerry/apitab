# CMake 构建产物
build/
# P1-B1.0a 三通道本地验证构建（源码 / SDK / 已安装 SDK 各自独立配置目录）
# 及各种本地变体构建目录
build-*/

# HuxerUI CLI 构建/生成产物（huxerui build/run 的构建目录与依赖图）
.huxerui/

# 旧 mcpp 构建产物（历史残留）
target/
.mcpp/

# CMake 导出的编译数据库（仓库根是指向 build/ 的软链）
compile_commands.json

# 本地 / CI 打包产物
dist/
dist-src/
apitab-v*

# 本地放置的 k6 二进制（engines/k6）
engines/

# 会话目录；项目技能与引用统一在 project-skills/，纳入版本管理
.claude/
# 其他桌面代理工具的工作区（会话计划等本地产物）
.zcode/
# HuxerUI 运行时帧跟踪转储（本地排障产物，单个文件可达数 MB）
traces/

# HuxerUI 上游源码 clone（存在时优先于 third_party/tarballs 的预编译 SDK）
third_party/huxerui/
# SweetEditor 组件库 clone（body/k6 脚本编辑器）
third_party/huxerui-sweetedit/
# WebView 组件库 clone（响应 HTML 预览；FarnaHerry/Lib-WebView fork 的 farna/main）
third_party/lib-webview/
# 用当前 huxerui 源码本地构建的宿主工具（hcg/hrc；上游 linux 预置可能落后于源码）
third_party/huxerui-tools/

# huxerui_add_app 生成物
.agents/
