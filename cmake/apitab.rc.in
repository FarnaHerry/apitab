// apitab.rc — Windows 资源：版本信息 + 图标。
// 版本号与顶层 CMakeLists 的 project(... VERSION ...) 保持一致（configure_file 生成）。
1 ICON "@CMAKE_SOURCE_DIR@/assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L   // VOS_NT_WINDOWS32
 FILETYPE       0x1L       // VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "apitab"
            VALUE "FileDescription",  "API testing and load testing tool"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "apitab"
            VALUE "OriginalFilename", "apitab.exe"
            VALUE "ProductName",      "apitab"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
