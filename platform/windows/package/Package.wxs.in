<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="apitab" Manufacturer="FarnaHerry" Version="@APITAB_WINDOWS_VERSION@"
           UpgradeCode="@_apitab_msi_upgrade_code@" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of apitab is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder"><Directory Id="INSTALLFOLDER" Name="apitab" /></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="APPLICATIONPROGRAMMENU" Name="apitab" /></StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER"><Files Include="!(bindpath.Application)\**" /></ComponentGroup>
    <Component Id="ApplicationShortcut" Directory="APPLICATIONPROGRAMMENU">
      <Shortcut Id="ApplicationStartMenuShortcut" Name="apitab" Target="[INSTALLFOLDER]apitab.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramMenu" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\FarnaHerry\apitab" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="ApplicationDesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="ApplicationDesktopShortcutLink" Name="apitab" Target="[INSTALLFOLDER]apitab.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\FarnaHerry\apitab" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Feature Id="Application" Title="apitab" Level="1"><ComponentGroupRef Id="ApplicationFiles" /><ComponentRef Id="ApplicationShortcut" /></Feature>
    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Level="2" AllowAbsent="yes"><Level Value="1" Condition="CREATE_DESKTOP_SHORTCUT = 1" /><ComponentRef Id="ApplicationDesktopShortcut" /></Feature>
  </Package>
</Wix>
