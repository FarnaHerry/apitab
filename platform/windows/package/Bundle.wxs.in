<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Bundle Name="apitab" Manufacturer="FarnaHerry" Version="@APITAB_WINDOWS_VERSION@"
          UpgradeCode="@_apitab_bundle_upgrade_code@">
    <BootstrapperApplication SourceFile="!(bindpath.Installer)\apitab-Installer.exe">
      <PayloadGroupRef Id="HuxerUIInstallerPayloads" />
    </BootstrapperApplication>
    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]apitab" />
    <Variable Name="CreateDesktopShortcut" Type="numeric" Value="0" />
    <Chain>
      <MsiPackage SourceFile="!(bindpath.Package)\apitab.msi">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="CREATE_DESKTOP_SHORTCUT" Value="[CreateDesktopShortcut]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
